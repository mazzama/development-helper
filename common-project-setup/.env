# PostgreSQL Configuration
POSTGRES_DB=myapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Application Database User
APP_USER=app_user
APP_PASSWORD=app_password

# Redis Configuration
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password  # Uncomment to enable Redis auth

# Grafana Configuration
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ALLOW_SIGN_UP=false

# Prometheus Configuration
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=200h

# Loki Configuration
LOKI_PORT=3100

# Tempo Configuration
TEMPO_PORT=3200

# Mimir Configuration
MIMIR_PORT=9009

# Exporter Ports
NODE_EXPORTER_PORT=9100
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121

# Data Retention Settings
LOKI_RETENTION_PERIOD=168h  # 7 days
PROMETHEUS_RETENTION=200h   # ~8 days
MIMIR_RETENTION_PERIOD=24h  # 1 day for TSDB

# Resource Limits (uncomment to enable)
# POSTGRES_MEMORY_LIMIT=1g
# REDIS_MEMORY_LIMIT=512m
# GRAFANA_MEMORY_LIMIT=256m
# PROMETHEUS_MEMORY_LIMIT=1g